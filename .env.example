PORT=5000
DB_USER=
DB_PASSWORD=
DB_CLUSTER=cluster0.xxxxx.mongodb.net
STRIPE_SECRET_KEY=

# URL of the client app (Better Auth signs the JWT access tokens there)
CLIENT_URL=http://localhost:3000

# Cron endpoint secret (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Email notifications (optional: leave empty to skip emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
